##Data Import Section

read_file -type verilog ../RTL/FIFO_MEM.v
read_file -type verilog ../RTL/FIFO_rptr_empty.v
read_file -type verilog ../RTL/FIFO_TOP.v
read_file -type verilog ../RTL/FIFO_wptr_full.v
